%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%% feuilleinterro.sty
%%% Package pour la mise en forme des interrogations de mathématiques.
%%% S'appuie sur feuille.sty (macros d'ensembles, environnements
%%% defi/prop/rem, etc.) mais SUPPRIME L'EN-TÊTE ET LE PIED DE PAGE et
%%% fournit une mise en page à 1 sujet par page, en format PORTRAIT :
%%%   - \interroversion{X} : bloc d'en-tête d'un sujet (classe en haut à
%%%     gauche, titre, champs Nom/Prénom), à placer en tête de chaque
%%%     sujet. L'argument #1 (lettre de version) est conservé pour ne pas
%%%     casser les documents existants mais n'est plus affiché.
%%%   - chaque sujet occupe sa propre page : séparer les sujets d'un même
%%%     document par un simple \newpage.
%%%
%%% Nommée \interroversion (et non \version) pour ne pas entrer en conflit
%%% avec \version, déjà utilisé par feuille.sty pour distinguer les
%%% compilations "prof" / "élève".
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{feuilleinterro}[2026/09/19 v5.0 Interrogation de mathématiques (portrait, sans en-tête ni pied de page, 1 sujet par page)]

\RequirePackage{feuille}

%%%SUPPRESSION DE L'EN-TÊTE ET DU PIED DE PAGE
\pagestyle{empty}

%%%MISE EN PAGE PORTRAIT, MARGES RESSERRÉES (pas d'en-tête/pied de page à
%%% loger, on peut donc réduire les marges hautes et basses par rapport à
%%% feuille.sty)
\geometry{
    portrait,
    left=2cm, right=2cm,
    top=1.5cm, bottom=1.5cm
}

%%%BLOC D'EN-TÊTE D'UN SUJET (titre + Nom/Prénom)
%%% Usage : \interroversion{A}  (à placer en tête de chaque sujet)
%%% Le titre reprend \chapitre (renseigné dans le document principal), afin
%%% de fonctionner pour n'importe quel chapitre sans dupliquer le préambule.
\newcommand{\interroversion}[1]{
    \noindent\textbf{\niveau}

    \vspace{-0.5cm}
    \begin{center}
        \textbf{\large INTERROGATION -- \chapitre}
    \end{center}

    \vspace{-0.1cm}

    \textbf{Nom :} \rule{2.7cm}{0.4pt}
    \hfill
    \textbf{Prénom :} \rule{2.3cm}{0.4pt}

    \vspace{0.2cm}
}

\endinput
