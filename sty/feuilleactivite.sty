\RequirePackage{feuille}
\fancyhead[L]{Activité}
%%%ENCADRÉ objectifs (nouveauté)
%%% Usage : \begin{objectifs} ... \end{objectifs}
%%%         \begin{objectifs}[Rappels] ... \end{objectifs}  (titre personnalisé)
\newtcolorbox{objectifs}[1][Objectifs]{
  colback=white, colframe=black,
  boxrule=0.6pt, arc=0pt,
  left=8pt, right=8pt, top=5pt, bottom=5pt,
  fonttitle=\bfseries\scshape, coltitle=black,
  colbacktitle=white,
  title=#1,
  before upper={\begin{multicols}{2}},
  after upper={\end{multicols}}
}

\NewDocumentEnvironment{definition}{s}{%
    \begin{cbox}
    \textbf{Définition\IfBooleanT{#1}{s} :}
}{%
    \end{cbox}
}

%%%ENCADRÉ indication (aide ponctuelle pour un travail en autonomie)
%%% Usage : \begin{indication} ... \end{indication}
%%%         \begin{indication}[Coup de pouce] ... \end{indication}  (titre personnalisé)
\newtcolorbox{indication}[1][Indication]{
  colback=black!3, colframe=black!50,
  boxrule=0.4pt, arc=0pt,
  left=6pt, right=6pt, top=4pt, bottom=4pt,
  fontupper=\small,
  fonttitle=\bfseries\scshape\small, coltitle=black!50,
  colbacktitle=black!3,
  title=#1
}